{
  "expo": {
    "name": "noteOS MVP-04 Prototype",
    "slug": "noteos-mvp04-prototype",
    "scheme": "noteos",
    "version": "0.4.0",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "local.noteos.mvp04",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow noteOS to record audio for notes stored on this device.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": false
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-asset"
    ]
  }
}
