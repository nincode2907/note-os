{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noteos:sync:v1",
  "title": "Phase 08.1 bootstrap summary envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "records"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contentHash",
          "lifecycle",
          "localRevision",
          "recordingCount"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "lifecycle": {
            "enum": [
              "active",
              "archived",
              "trashed"
            ]
          },
          "localRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "recordingCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    }
  }
}
