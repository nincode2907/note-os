diff --git a/spikes/phase-00/gate1/mobile/scripts/build-editor-bundle.mjs b/spikes/phase-00/gate1/mobile/scripts/build-editor-bundle.mjs
new file mode 100644
index 0000000..a244bde
--- /dev/null
+++ b/spikes/phase-00/gate1/mobile/scripts/build-editor-bundle.mjs
@@ -0,0 +1,25 @@
+import { readFile, writeFile } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import path from 'node:path';
+import { build } from 'esbuild';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const [result, template] = await Promise.all([
+  build({
+    absWorkingDir: root,
+    entryPoints: ['editor/webview-entry.js'],
+    bundle: true,
+    minify: true,
+    write: false,
+    format: 'iife',
+    platform: 'browser',
+    target: ['safari15'],
+    legalComments: 'inline',
+  }),
+  readFile(path.join(root, 'editor/canonical-editor.template.html'), 'utf8'),
+]);
+const script = result.outputFiles[0].text.replace(/<\/script/giu, '<\\/script');
+if (template.split('__EDITOR_SCRIPT__').length !== 2) throw new Error('Editor bundle template must contain one script placeholder.');
+const html = template.replace('__EDITOR_SCRIPT__', () => script);
+await writeFile(path.join(root, 'editor/canonical-editor.html'), html);
+console.log(`Built offline Tiptap editor asset (${Buffer.byteLength(html)} bytes).`);
diff --git a/spikes/phase-00/gate1/mobile/scripts/editor-browser-check.mjs b/spikes/phase-00/gate1/mobile/scripts/editor-browser-check.mjs
new file mode 100644
index 0000000..29b9327
--- /dev/null
+++ b/spikes/phase-00/gate1/mobile/scripts/editor-browser-check.mjs
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { validateCanonicalDocument } from '../../web/packages/document-engine/src/index.js';
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const workspace = path.resolve(root, '../../../../..');
+const lens = process.env.NOTEOS_PLAYWRIGHT_ROOT ?? path.resolve(workspace, 'ui-lens');
+const require = createRequire(import.meta.url);
+const { chromium } = require(require.resolve('playwright', { paths: [lens] }));
+const fixture = JSON.parse(await readFile(path.resolve(root, '../web/packages/document-engine/fixtures/schema-v1-rich.json'), 'utf8'));
+fixture.content[1].content.push({ type: 'text', text: ' — removed', marks: [{ type: 'strike' }] });
+fixture.content[3].content[0].content.push({ type: 'taskList', content: [{ type: 'taskItem', attrs: { checked: true }, content: [{ type: 'paragraph', content: [{ type: 'text', text: 'nested checked task' }] }] }] });
+const browser = await chromium.launch();
+const page = await browser.newPage();
+const externalRequests = [];
+const runtimeErrors = [];
+page.on('request', request => { if (!request.url().startsWith('file:')) externalRequests.push(request.url()); });
+page.on('pageerror', error => runtimeErrors.push(error.message));
+page.on('console', message => { if (message.type() === 'error') runtimeErrors.push(message.text()); });
+try {
+  await page.addInitScript(() => {
+    window.__nativeMessages = [];
+    window.ReactNativeWebView = { postMessage(raw) { window.__nativeMessages.push(JSON.parse(raw)); } };
+  });
+  await page.goto(pathToFileURL(path.join(root, 'editor/canonical-editor.html')).href);
+  await page.evaluate(document => window.dispatchEvent(new MessageEvent('message', { data: JSON.stringify({ v: 1, sessionId: 'synthetic-note:session-1', generation: 1, type: 'INIT_DOCUMENT', payload: { document, editable: true } }) })), fixture);
+  await page.waitForFunction(() => window.__nativeMessages.some(message => message.type === 'EDITOR_READY'), null, { timeout: 5000 }).catch(async () => {
+    const diagnostic = await page.evaluate(() => ({ readyState: document.readyState, error: document.getElementById('error')?.textContent, editorText: document.getElementById('editable')?.innerText, nativeMessages: window.__nativeMessages }));
+    throw new Error(`The bundled editor did not become ready. ${JSON.stringify({ diagnostic, runtimeErrors })}`);
+  });
+  assert.equal(await page.locator('#editable h2').textContent(), 'noteOS document v1');
+  assert.equal(await page.locator('#editable blockquote').count(), 1);
+  assert.equal(await page.locator('#editable pre code').textContent(), 'const answer = `42`;');
+  assert.equal(await page.locator('#editable ol[start="3"]').count(), 1);
+  assert.equal(await page.locator('#editable ul[data-type="taskList"] ul[data-type="taskList"]').count(), 1);
+  assert.equal(await page.locator('#editable [data-noteos-attachment="asset-01"]').count(), 1);
+  assert.equal(await page.locator('#editable p s').textContent(), ' — removed');
+
+  await page.locator('#editable').dispatchEvent('compositionstart', { data: 'かな' });
+  await page.evaluate(() => window.dispatchEvent(new MessageEvent('message', { data: JSON.stringify({ v: 1, sessionId: 'synthetic-note:session-1', generation: 2, type: 'REQUEST_DOCUMENT', payload: { requestId: 'composition-check' } }) })));
+  await page.waitForTimeout(100);
+  assert.equal(await page.evaluate(() => window.__nativeMessages.some(message => message.type === 'DOCUMENT_SNAPSHOT' && message.payload.requestId === 'composition-check')), false);
+  await page.locator('#editable').dispatchEvent('compositionend', { data: 'かな' });
+  await page.waitForFunction(() => window.__nativeMessages.some(message => message.type === 'DOCUMENT_SNAPSHOT' && message.payload.requestId === 'composition-check'));
+
+  await page.evaluate(() => {
+    const text = [...document.querySelectorAll('#editable p')].find(node => node.textContent === 'open task');
+    const range = document.createRange(); range.selectNodeContents(text);
+    const selection = window.getSelection(); selection.removeAllRanges(); selection.addRange(range);
+  });
+  await page.locator('[data-command="bold"]').click();
+  await page.locator('#editable input[type="checkbox"]').first().click();
+  await page.waitForFunction(() => window.__nativeMessages.some(message => message.type === 'DOCUMENT_CHANGED'));
+
+  await page.evaluate(() => window.dispatchEvent(new MessageEvent('message', { data: JSON.stringify({ v: 1, sessionId: 'synthetic-note:session-1', generation: 3, type: 'REQUEST_DOCUMENT', payload: { requestId: 'browser-check-1' } }) })));
+  await page.waitForFunction(() => window.__nativeMessages.some(message => message.type === 'DOCUMENT_SNAPSHOT' && message.payload.requestId === 'browser-check-1'));
+  const snapshot = await page.evaluate(() => window.__nativeMessages.find(message => message.type === 'DOCUMENT_SNAPSHOT' && message.payload.requestId === 'browser-check-1'));
+  const expected = validateCanonicalDocument(fixture).document;
+  assert.deepEqual(snapshot.payload.document.content[1], expected.content[1]);
+  assert.equal(snapshot.payload.document.content[2].content[0].content[1].type, 'orderedList');
+  assert.deepEqual(snapshot.payload.document.content[3].content.map(task => task.attrs.checked), [true, true]);
+  assert.equal(snapshot.payload.document.content[3].content[0].content[1].content[0].attrs.checked, true);
+  const openedTask = snapshot.payload.document.content[3].content[0].content[0].content[0];
+  assert.ok(openedTask.marks?.some(mark => mark.type === 'bold'));
+  assert.equal(externalRequests.length, 0, `Offline editor attempted network requests: ${externalRequests.join(', ')}`);
+  console.log(`PASS Chromium ${browser.version()}: local Tiptap runtime, canonical round-trip, bold toolbar, task toggle, IME snapshot deferral, and zero external requests.`);
+} finally {
+  await browser.close();
+}
diff --git a/spikes/phase-00/gate1/mobile/tests/editor-bridge.test.mjs b/spikes/phase-00/gate1/mobile/tests/editor-bridge.test.mjs
new file mode 100644
index 0000000..2e15249
--- /dev/null
+++ b/spikes/phase-00/gate1/mobile/tests/editor-bridge.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { createEditorSession, validateEditorEnvelope } from '../editor-bridge.mjs';
+import { canEditNativeNote, recoveryDecision, SingleSaveGate } from '../mobile-safety.mjs';
+import { validateCanonicalDocument } from '../../web/packages/document-engine/src/index.js';
+
+const rich = JSON.parse(await readFile(new URL('../../web/packages/document-engine/fixtures/schema-v1-rich.json', import.meta.url), 'utf8'));
+rich.content[1].content.push({ type: 'text', text: ' — removed', marks: [{ type: 'strike' }] });
+rich.content[3].content[0].content.push({ type: 'taskList', content: [{ type: 'taskItem', attrs: { checked: true }, content: [{ type: 'paragraph', content: [{ type: 'text', text: 'nested checked task' }] }] }] });
+const envelope = (type, payload, generation = 1, sessionId = 'note-1:session-a') => JSON.stringify({ v: 1, sessionId, generation, type, payload });
+
+test('canonical rich structure, formatting, nested lists, tasks, and multilingual text survive bridge validation', () => {
+  const parsed = validateEditorEnvelope(envelope('DOCUMENT_CHANGED', { document: rich }), { sessionId: 'note-1:session-a' });
+  assert.equal(parsed.ok, true);
+  assert.deepEqual(parsed.document, validateCanonicalDocument(rich).document);
+  const heading = parsed.document.content[0];
+  assert.equal(heading.type, 'heading');
+  assert.equal(heading.attrs.level, 2);
+  const paragraph = parsed.document.content[1];
+  assert.deepEqual(paragraph.content[1].marks.map(mark => mark.type), ['bold', 'italic']);
+  assert.equal(paragraph.content[3].marks[0].attrs.href, 'https://example.test/notes');
+  assert.deepEqual(paragraph.content[6].marks.map(mark => mark.type), ['strike']);
+  assert.equal(paragraph.content[0].text, 'Tiếng Việt: á, ');
+  assert.equal(paragraph.content[1].text, '東京・かな・カナ 🙂');
+  assert.equal(parsed.document.content[2].content[0].content[1].type, 'orderedList');
+  assert.deepEqual(parsed.document.content[3].content.map(task => task.attrs.checked), [false, true]);
+  assert.equal(parsed.document.content[3].content[0].content[1].content[0].attrs.checked, true);
+  assert.equal(parsed.document.content[5].attrs.language, 'ts');
+  assert.deepEqual(parsed.document.content[6].content[0].attrs, { attachmentId: 'asset-01', label: 'diagram.png' });
+});
+
+test('snapshot replies require the matching request id and preserve checked states', () => {
+  const parsed = validateEditorEnvelope(envelope('DOCUMENT_SNAPSHOT', { document: rich, requestId: 'request-7' }, 9), { sessionId: 'note-1:session-a', afterGeneration: 8 });
+  assert.equal(parsed.ok, true);
+  assert.equal(parsed.message.payload.requestId, 'request-7');
+  assert.deepEqual(parsed.document.content[3].content.map(task => task.attrs.checked), [false, true]);
+  assert.equal(validateEditorEnvelope(envelope('DOCUMENT_SNAPSHOT', { document: rich, requestId: 'x'.repeat(101) }), { sessionId: 'note-1:session-a' }).ok, false);
+});
+
+test('unsupported future schema remains unchanged and cannot enter an editable bridge message', () => {
+  const future = { schemaVersion: 2, type: 'doc', content: [{ type: 'futureBlock', payload: { keep: ['all', 'data'] } }] };
+  const before = JSON.stringify(future);
+  const parsed = validateEditorEnvelope(envelope('DOCUMENT_CHANGED', { document: future }), { sessionId: 'note-1:session-a' });
+  assert.equal(parsed.ok, false);
+  assert.equal(JSON.stringify(future), before);
+  assert.equal(canEditNativeNote({ lifecycle: 'active', schemaVersion: 1 }, false), false);
+});
+
+test('malformed canonical documents and unsafe link protocols are rejected', () => {
+  const unsafe = structuredClone(rich);
+  unsafe.content[1].content[3].marks[0].attrs.href = 'javascript:alert(1)';
+  for (const document of [null, { schemaVersion: 1, type: 'doc', content: [{ type: 'paragraph', content: 'bad' }] }, unsafe]) {
+    const parsed = validateEditorEnvelope(envelope('DOCUMENT_CHANGED', { document }), { sessionId: 'note-1:session-a' });
+    assert.equal(parsed.ok, false);
+  }
+});
+
+test('bridge rejects malformed envelopes, unknown message types, oversized messages, and wrong-note sessions', () => {
+  assert.equal(validateEditorEnvelope('{broken', { sessionId: 'note-1:session-a' }).ok, false);
+  assert.equal(validateEditorEnvelope(envelope('EXECUTE', {}, 1), { sessionId: 'note-1:session-a' }).ok, false);
+  assert.equal(validateEditorEnvelope(' '.repeat(2 * 1024 * 1024 + 1), { sessionId: 'note-1:session-a' }).ok, false);
+  assert.equal(validateEditorEnvelope(envelope('EDITOR_READY', { editable: true }, 1, 'note-2:session-b'), { sessionId: 'note-1:session-a' }).ok, false);
+  assert.equal(createEditorSession('note-1', 'nonce-a') === createEditorSession('note-2', 'nonce-a'), false);
+});
+
+test('stale and out-of-order WebView generations are rejected', () => {
+  assert.equal(validateEditorEnvelope(envelope('EDITOR_READY', { editable: true }, 4), { sessionId: 'note-1:session-a', afterGeneration: 4 }).ok, false);
+  assert.equal(validateEditorEnvelope(envelope('EDITOR_READY', { editable: true }, 3), { sessionId: 'note-1:session-a', afterGeneration: 5 }).ok, false);
+  assert.equal(validateEditorEnvelope(envelope('EDITOR_READY', { editable: true }, Number.MAX_SAFE_INTEGER + 1), { sessionId: 'note-1:session-a' }).ok, false);
+});
+
+test('background recovery decision only offers a same-revision active schema-v1 draft', () => {
+  const journal = { baseRevision: 8, draft: { version: 1, document: rich } };
+  assert.equal(recoveryDecision({ revision: 8, lifecycle: 'active', schemaVersion: 1 }, journal), 'offer-restore');
+  assert.equal(recoveryDecision({ revision: 9, lifecycle: 'active', schemaVersion: 1 }, journal), 'preserve-only');
+  assert.equal(recoveryDecision({ revision: 8, lifecycle: 'trashed', schemaVersion: 1 }, journal), 'preserve-only');
+});
+
+test('native save gate in source prevents overlapping commits and preserves the revision CAS call', async () => {
+  const gate = new SingleSaveGate();
+  assert.equal(gate.begin(), true);
+  assert.equal(gate.begin(), false);
+  gate.finish();
+  assert.equal(gate.begin(), true);
+  gate.finish();
+  const source = await readFile(new URL('../App.tsx', import.meta.url), 'utf8');
+  assert.match(source, /recoveryHeld \|\| !saveLock\.current\.begin\(\)\) return false/);
+  assert.match(source, /saveNote\(\{ \.\.\.capturedNote, title: capturedTitle, document: validation\.document, tags: nextTags, pinned: capturedPinned \}, capturedNote\.revision\)/);
+  assert.match(source, /await flushDraft\(\{ note: capturedNote, title: capturedTitle, tags: capturedTags, pinned: capturedPinned, document: validation\.document \}\)/);
+});
